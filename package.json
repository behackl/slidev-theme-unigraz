{
  "name": "slidev-theme-behackl-kfu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=18.0.0",
    "slidev": ">=0.19.3"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/openmoji": "^1.2.17",
    "@iconify-json/twemoji": "^1.2.4",
    "@iconify/vue": "^4.3.0",
    "@slidev/types": "^52.7.0"
  },
  "devDependencies": {
    "@slidev/cli": "^52.7.0",
    "prettier": "^3.6.2"
  },
  "//": "Learn more: https://sli.dev/themes/write-a-theme.html",
  "slidev": {
    "colorSchema": "both",
    "highlighter": "all",
    "defaults": {
      "author": "Benjamin Hackl",
      "transition": "slide-left",
      "fonts": {
        "sans": "Nunito Sans",
        "mono": "Fira Mono"
      }
    }
  }
}
